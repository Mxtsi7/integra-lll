# ══════════════════════════════════════════════════════════════
# PLANTILLA DE VARIABLES DE ENTORNO
#
# Copia este archivo como .env y complétalo con los valores reales:
#   cp .env.example .env
#
# ⚠️ .env está en .gitignore y NUNCA debe subirse al repositorio.
#    Este archivo sí se sube, pero solo con valores de ejemplo.
#
#    Si por error subes una credencial real, borrarla en el siguiente
#    commit NO basta: el historial de git la conserva. Hay que rotarla
#    en el servicio y avisar al equipo.
# ══════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,gateway

# ─── PostgreSQL ───────────────────────────────────────────────
# Una sola instancia, un esquema por servicio (ver ADR-002).
# Cada contenedor recibe además ESQUEMA_BD desde docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/suscripciones

# ─── RabbitMQ (eventos entre servicios) ───────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
EXCHANGE_EVENTOS=suscripciones

# ─── Redis (Celery, tareas periódicas de connectors) ──────────
CELERY_BROKER_URL=redis://redis:6379/0

# ─── JWT ──────────────────────────────────────────────────────
# auth firma los tokens, el gateway valida la firma (ver ADR-004).
# El secreto debe ser IDÉNTICO en ambos.
JWT_SECRET=cambiar-esto-por-otra-clave-larga-y-aleatoria
JWT_ALGORITMO=HS256
JWT_MINUTOS_ACCESO=30
JWT_DIAS_REFRESCO=7

# ─── Cifrado de secretos en reposo (tokens de conectores) ─────
# Una o más claves Fernet separadas por coma. La PRIMERA cifra, todas
# descifran: así se rota sin perder lo guardado (shared/cifrado/README.md).
# Generar una:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# En el cluster vive en el Secret, no acá.
CLAVES_CIFRADO=

# ─── Contraseñas (servicio auth) ─────────────────────────────
# Iteraciones de PBKDF2. Sin definir usa las de Django, que es lo que va en
# local. El cluster las baja en k8s/00-configuracion.yaml (ver ahí por qué).
# PBKDF2_ITERACIONES=

# ─── Usuario de demostración (solo desarrollo) ────────────────
# docker-compose.yml arranca auth con SEED_DEMO=1: la primera vez crea este
# usuario (clave hasheada) y las siguientes no hace nada. Cámbialos si
# quieres otros; en producción SEED_DEMO no va.
SEED_CORREO=demo@ojoalgasto.cl
SEED_CLAVE=Demo-2026-ojo
SEED_NOMBRE=Usuario Demo

# ─── Frontend ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
# URL pública que auth usa para construir el enlace de recuperación.
FRONTEND_URL=http://localhost:5173

# ─── Conector Spotify (servicio connectors) ───────────────────
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/conectores/spotify/callback/

# ─── Conector Gmail (servicio connectors) ─────────────────────
# Google Cloud Console → Credenciales → ID de cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/conectores/gmail/callback/

# ─── IA (servicio analytics) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Correo (servicios auth y notifications) ──────────────────
# No usar el backend console: imprime los tokens de recuperación en logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=no-responder@ejemplo.cl


# Debe ser idéntico en auth y gateway; base dedicada al estado de sesiones.
SESSION_REDIS_URL=redis://redis:6379/2

# OAuth client ID de inicio de sesión Google; vacío deshabilita MX-11 con 503.
GOOGLE_CLIENT_ID=

# Secreto independiente compartido por auth y los cuatro consumidores de limpieza.
# Requerido para procesar eliminaciones; generar y guardar fuera del repositorio.
ELIMINACION_INTERNA_SECRET=
URL_SUBSCRIPTIONS=http://subscriptions:8002
URL_CONNECTORS=http://connectors:8003
URL_ANALYTICS=http://analytics:8004
URL_NOTIFICATIONS=http://notifications:8005
# Los servidores aplican migraciones; Compose fija 0 en connectors-worker.
# APLICAR_MIGRACIONES=1
