# ─── Secretos ─────────────────────────────────────────────────
# NUNCA subir estos archivos. Si uno se sube por error, hay que
# rotar TODAS las credenciales que contenía: el historial de git
# las conserva aunque después borres el archivo.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json
service-account*.json

# ─── Python / Django ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
db.sqlite3
db.sqlite3-journal
/backend/media/
/backend/staticfiles/
celerybeat-schedule*

# ─── Node / React ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache

# ─── Editores ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Temporales y respaldos ───────────────────────────────────
*.log
*.bak
*.tmp
~$*

