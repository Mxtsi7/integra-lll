# La web, compilada y servida por nginx.
#
#     docker build -f k8s/Dockerfile.web \
#       --build-arg VITE_API_URL=https://ojoalgasto-forellana.dev.censei.cl/api \
#       frontend/
#
# En docker compose la web corre con `vite dev`, que sirve para desarrollar
# pero no para Kubernetes: es lento, recarga solo y expone el código fuente.
# Acá se compila una vez y nginx entrega archivos estáticos.
#
# OJO: `VITE_API_URL` se resuelve al COMPILAR, no al arrancar. Si cambia la
# URL pública hay que reconstruir la imagen; no basta con editar un ConfigMap.

FROM node:20-alpine AS compilacion

WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY web/package.json web/
RUN npm ci

COPY . .
# El valor por omisión es `/api`, que es el correcto para Kubernetes: el nginx
# de la web proxea /api/ hacia el gateway, así que la URL relativa sirve para
# cualquier host sin reconstruir.
#
# Va acá y no solo en desplegar.sh a propósito: en Git Bash (Windows) un
# `--build-arg VITE_API_URL=/api` se convierte SOLO en
# `VITE_API_URL=C:/Program Files/Git/api`, y como `C:` parece un esquema de
# URL el navegador nunca llega a emitir la petición. Con el valor por omisión
# acá, el build sale bien aunque el argumento venga mal desde el shell.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Red de seguridad: una URL base inválida produce un bundle que carga perfecto
# y falla recién al pedir datos, sin dejar rastro en los logs del servidor.
# Solo se acepta una ruta relativa (/algo) o una URL http(s). La conversión de
# Git Bash produce `C:/Program Files/Git/api`, que no es ninguna de las dos.
RUN case "$VITE_API_URL" in \
      /*)                 echo "VITE_API_URL=$VITE_API_URL" ;; \
      http://*|https://*) echo "VITE_API_URL=$VITE_API_URL" ;; \
      *) echo "ERROR: VITE_API_URL invalida: '$VITE_API_URL'" >&2; \
         echo "       Se esperaba /algo o http(s)://algo." >&2; \
         echo "       En Git Bash usa: MSYS_NO_PATHCONV=1 docker build ..." >&2; \
         exit 1 ;; \
    esac

RUN npm run build --workspace=web


FROM nginx:1.27-alpine

COPY --from=compilacion /app/web/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
