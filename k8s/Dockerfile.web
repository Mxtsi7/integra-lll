# La web, compilada y servida por nginx.
#
#     docker build -f k8s/Dockerfile.web \
#       --build-arg VITE_API_URL=https://ojoalgasto-forellana.dev.censei.cl/api \
#       frontend/
#
# En docker compose la web corre con `vite dev`, que sirve para desarrollar
# pero no para Kubernetes: es lento, recarga solo y expone el código fuente.
# Acá se compila una vez y nginx entrega archivos estáticos.
#
# OJO: `VITE_API_URL` se resuelve al COMPILAR, no al arrancar. Si cambia la
# URL pública hay que reconstruir la imagen; no basta con editar un ConfigMap.

FROM node:20-alpine AS compilacion

WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY web/package.json web/
RUN npm ci

COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
# ── La URL se comprueba ANTES de compilar ───────────────────────────────────
# Git Bash en Windows convierte un argumento que empieza con `/` en una ruta:
# `--build-arg VITE_API_URL=/api` llegaba aca como
# `C:/Program Files/Git/api`, la compilacion terminaba bien y la web quedaba
# llamando a una direccion que no existe. Paso dos veces (la segunda, el
# 09-11-2026) y solo se ve abriendo el JavaScript ya compilado.
#
# Vale una ruta que empiece con `/` o una URL http(s). Cualquier otra cosa
# corta la construccion con el valor a la vista.
RUN case "$VITE_API_URL" in /*|http://*|https://*) ;; *) echo "VITE_API_URL invalida: '$VITE_API_URL'. Si estas en Git Bash, antepone MSYS_NO_PATHCONV=1." >&2; exit 1 ;; esac
RUN npm run build --workspace=web


FROM nginx:1.27-alpine

COPY --from=compilacion /app/web/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
