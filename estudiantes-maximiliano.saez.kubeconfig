apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://k8s-estudiantes.dev.censei.cl
  name: estudiantes
contexts:
- context:
    cluster: estudiantes
    namespace: student-maximiliano-saez-cd928ab3cf06
    user: oidc
  name: estudiante-maximiliano.saez
current-context: estudiante-maximiliano.saez
kind: Config
users:
- name: oidc
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      args:
      - oidc-login
      - get-token
      - --oidc-issuer-url=https://auth.dev.censei.cl
      - --oidc-client-id=kubernetes
      - --oidc-extra-scope=profile
      - --oidc-extra-scope=email
      - --grant-type=authcode
      command: kubectl
      env: null
      interactiveMode: IfAvailable
      provideClusterInfo: false
