# Copia este archivo como .env dentro de services/analytics-uso/ o define las
# variables en el entorno. No subas credenciales reales al repositorio.

# PostgreSQL compartido. El esquema `analytics` ya existe.
DATABASE_URL=postgres://postgres:cambiar@localhost:5432/suscripciones

# RabbitMQ compartido.
RABBITMQ_URL=amqp://ojoalgasto:cambiar@localhost:5672/

# Topología del contrato de uso (S3-VI-10).
EXCHANGE_USO=uso.eventos
EXCHANGE_DLX=uso.eventos.dlx
COLA_USO=analytics.uso.cola
COLA_FALLOS=analytics.uso.fallos
ROUTING_KEY_USO=uso.registrado

# Consumo y reintentos.
PREFETCH=20
MAX_REINTENTOS=5

# debug | info | warn | error
LOG_LEVEL=info

# Opcional: ruta explícita al DDL para `npm run migrar`.
# SQL_MIGRACION=./sql/001_uso_recolectores.sql
