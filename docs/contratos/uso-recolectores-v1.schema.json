{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UsoRecolectoresV1",
  "$ref": "#/$defs/UsageEventPayload",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "origen": {"enum": ["android", "navegador"]},
    "cobertura": {"enum": ["completa", "parcial", "sin_medicion"]},
    "estado": {"enum": ["activo", "pausado", "sin_permiso", "revocado"]},
    "tramo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": {"$ref": "#/$defs/utc"},
        "fin": {"$ref": "#/$defs/utc"}
      }
    },
    "UsageEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "event_id", "recolector_id", "origen", "inicio", "fin", "duracion_ms", "tramos_actividad", "zona_horaria", "cobertura", "estado"],
      "properties": {
        "version": {"const": 1},
        "event_id": {"$ref": "#/$defs/uuidV4"},
        "recolector_id": {"$ref": "#/$defs/uuidV4"},
        "origen": {"$ref": "#/$defs/origen"},
        "inicio": {"$ref": "#/$defs/utc"},
        "fin": {"$ref": "#/$defs/utc"},
        "duracion_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "tramos_actividad": {"type": "array", "items": {"$ref": "#/$defs/tramo"}},
        "zona_horaria": {"type": "string", "minLength": 1},
        "cobertura": {"$ref": "#/$defs/cobertura"},
        "estado": {"$ref": "#/$defs/estado"}
      }
    },
    "CoverageIntervalPayload": {
      "description": "Proyeccion interna derivada; no es entrada autenticable del cliente.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "coverage_id", "event_id", "usuario_id", "suscripcion_id", "recolector_id", "origen", "inicio", "fin", "zona_horaria", "cobertura", "estado"],
      "properties": {
        "version": {"const": 1},
        "coverage_id": {"$ref": "#/$defs/uuidV4"},
        "event_id": {"$ref": "#/$defs/uuidV4"},
        "usuario_id": {"$ref": "#/$defs/uuid"},
        "suscripcion_id": {"$ref": "#/$defs/uuid"},
        "recolector_id": {"$ref": "#/$defs/uuidV4"},
        "origen": {"$ref": "#/$defs/origen"},
        "inicio": {"$ref": "#/$defs/utc"},
        "fin": {"$ref": "#/$defs/utc"},
        "zona_horaria": {"type": "string", "minLength": 1},
        "cobertura": {"$ref": "#/$defs/cobertura"},
        "estado": {"$ref": "#/$defs/estado"}
      }
    }
  }
}
